{
  "name": "slipbox",
  "version": "0.10.0",
  "private": true,
  "description": "A tactile, sequential Slipbox for Obsidian",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "rm -rf dist && tsc -p tsconfig.test.json && node --test dist/test/*.test.js",
    "lint": "eslint .",
    "check": "npm run typecheck && npm test && npm run lint && npm run build",
    "generate:scale-vault": "node scripts/generate-scale-vault.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^25.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "obsidian": "latest",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0"
  }
}

{
  "name": "slipbox",
  "version": "0.10.0",
  "private": true,
  "description": "A tactile, sequential Slipbox for Obsidian",
  "license": "0BSD",
  "main": "main.js",
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint .",
    "check": "npm run typecheck && npm test && npm run lint && npm run build && npm run validate:release",
    "validate:release": "node scripts/validate-release.mjs",
    "preversion": "npm run check",
    "version": "node version-bump.mjs && npm run validate:release && git add manifest.json versions.json package-lock.json",
    "generate:scale-vault": "node scripts/generate-scale-vault.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^25.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "obsidian": "latest",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0"
  }
}
